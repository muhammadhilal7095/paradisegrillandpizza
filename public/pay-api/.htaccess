# The payment API's settings (written at build time, holds the Stripe secret key) must never be downloaded.
<FilesMatch "^(config|fulfil)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

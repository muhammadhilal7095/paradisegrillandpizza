# Copy to .env.local (git-ignored) and set the real value.
# Base URL of the auth API, without a trailing slash. Example from the API guide:
# VITE_API_BASE_URL=https://pos.paradisegap.co.uk/api
VITE_API_BASE_URL=

# Optional: endpoint for the Contact page form (see src/config/contact.ts).
VITE_CONTACT_ENDPOINT=

# WhatsApp ordering: the restaurant's number in international format, digits only (e.g. 447700900123).
# Leave empty and the WhatsApp order button stays hidden (see src/config/ordering.ts).
VITE_WHATSAPP_NUMBER=

# Optional: your own order API / POS endpoint. Checkout POSTs the order as JSON and only shows
# "order received" after a 2xx response. Leave empty to offer WhatsApp ordering only.
VITE_ORDER_ENDPOINT=

# ---- Menu proxy (server-only: never prefix these with VITE_) ----
# The POS only shares products with logged-in accounts. The site's server logs in with this
# dedicated customer account and serves the menu at /menu-api (see server/menuProxy.js), so every
# visitor sees it. Create an ordinary customer account just for this (e.g. register on the site).
POS_API_BASE_URL=https://pos.paradisegap.co.uk/api
POS_MENU_EMAIL=
POS_MENU_PASSWORD=

# ---- Card payments: Stripe Checkout (server-only, see server/payments.js) ----
# A RESTRICTED key (rk_live_…) with write access to Checkout Sessions is enough. Never prefix with VITE_.
STRIPE_SECRET_KEY=
# The site's public address, used for Stripe's return links (e.g. https://www.paradisegrill.co.uk).
# Leave empty in development: the request's own address is used.
SITE_URL=

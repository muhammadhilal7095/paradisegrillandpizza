# Static hosting (Apache/LiteSpeed): send every page route (/menu, /offers, …) to index.html
# so the React router can show it. Real files (images, /assets) are served as they are.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  # Card payments: the PHP payment API (pay-api/index.php) answers /pay-api/status, /checkout and /session.
  # Its settings file holds the Stripe secret key and is never served.
  RewriteRule ^pay-api/config\.php$ - [F,L]
  RewriteRule ^pay-api/(status|checkout|session)/?$ pay-api/index.php [L,QSA]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
